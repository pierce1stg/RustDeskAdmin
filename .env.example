# ================================================================
# rustdesk-stack environment configuration
# ----------------------------------------------------------------
# Copy to .env and set at least DOMAIN and LETSENCRYPT_EMAIL:
#     cp .env.example .env
#     ./setup.sh   # fills empty secrets automatically
#
# DOMAIN must resolve (DNS A record) to this server's public IP.
# ================================================================

# ----- Block A: required ---------------------------------------
# Public hostname of this instance
DOMAIN=app.example.com

# Email for Let's Encrypt (renewal warnings). Leave empty to run
# with the self-signed placeholder certificate only.
LETSENCRYPT_EMAIL=admin@example.com

# Database and JWT secrets. setup.sh replaces "changeme" with
# random values on first run.
POSTGRES_PASSWORD=changeme
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# ----- Block B: one-time seeds (panel owns settings afterwards) -
# Initial admin login (SERIOUSLY change it from the panel).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Seconds between live device presence refreshes.
STATUS_REFRESH_INTERVAL=30

# Session token lifetimes. One-time seeds used on the first start
# only; afterwards the admin panel (Settings -> Session) owns them.
ACCESS_TOKEN_TTL_MINUTES=60   # access token lifetime in minutes (5..10080)
REFRESH_TOKEN_TTL_DAYS=7      # refresh token/session lifetime in days (1..365)

# Optional manual address for Server Info; empty => DOMAIN is used.
SERVER_DISPLAY_ADDRESS=

# Optional server public key seed. On a fresh stack hbbs generates
# its key in ./data/hbbs on first start, and the backend reads it
# from there automatically (Server Info source "rustdesk-server").
RUSTDESK_PUBLIC_KEY=

# Server Info port defaults (used only as settings seeds).
RUSTDESK_ID_PORT=21116
RUSTDESK_RELAY_PORT=21117
RUSTDESK_WS_PORT=21118

# Directory where download-page screenshots are stored (bind-mounted into the
# backend). Empty => /screenshots (mounted from ./data/screenshots).
SCREENSHOTS_DIR=

# ----- Host port mapping ---------------------------------------
# Change these if the ports are already taken on the host
# (e.g. HTTPS_PORT=8443 when another service owns 443).
HTTP_PORT=80
HTTPS_PORT=443
NAT_PORT=21115
ID_PORT=21116
RELAY_PORT=21117
WSS_ID_PORT=21118
WSS_RELAY_PORT=21119
API_PORT=8080

# ----- Block C: download sources / mirrors (all optional) --------
# Leave empty to use the official sources. Set them manually if your
# host cannot reach the default registries (air-gapped / region with
# blocked access). Rebuild after changing:  ./setup.sh
# ----------------------------------------------------------------

# Docker registry prefix, prepended to every image name (runtime
# images in compose AND FROM base images in the Dockerfiles).
# Must end with a slash. Examples:
#   mirror.example.com/
#   registry.cn-hangzhou.aliyuncs.com/
DOCKER_REGISTRY_PREFIX=

# Go module proxy (default: https://proxy.golang.org,direct)
# Examples: https://goproxy.cn,direct  https://goproxy.io,direct
GOPROXY=

# npm registry (default: https://registry.npmjs.org)
# Examples: https://registry.npmmirror.com  https://registry.yarnpkg.com
NPM_REGISTRY=

# Alpine apk mirror base URL. Replaces the default host
# "https://dl-cdn.alpinelinux.org/alpine" inside the built images.
# Example: https://mirror.example.com/alpine
APK_MIRROR=

# ----- Block D: docker cleanup after setup/build (optional) -----
# Runs at the end of ./setup.sh to keep the disk lean.
#   all  - remove every image not used by a running container
#          (re-pulled on the next build) + stopped one-shot
#          containers and unused networks/volumes (default)
#   safe - remove only dangling images + build cache
#   none - no cleanup
# Note: "all" also affects images of OTHER projects on this host.
# On a tight disk, run  docker image prune -a -f  before re-running
# ./setup.sh if a rebuild ran out of space.
# ----------------------------------------------------------------
DOCKER_PRUNE_ON_BUILD=all